# Copy this file to .env for local development.
# The values below are non-secret development placeholders. Never commit .env.

# Service ports
INGESTION_SERVER_PORT=8080
PROCESSING_SERVER_PORT=8081

# Kafka
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_ORDER_EVENTS_TOPIC=order.events.v1
KAFKA_PUBLISH_TIMEOUT=5s
KAFKA_ORDER_EVENTS_DLT_TOPIC=order.events.v1.dlt
KAFKA_PROCESSING_CONSUMER_GROUP=order-processing-v1
KAFKA_CONSUMER_CONCURRENCY=3
KAFKA_DEFAULT_PARTITIONS=3

# Kafka TLS stores for the cloud profile. Locations should use file: URLs.
# Never commit the stores or their real passwords.
KAFKA_SSL_KEYSTORE_LOCATION=file:/path/to/client.keystore.p12
KAFKA_SSL_KEYSTORE_PASSWORD=replace_with_keystore_password
KAFKA_SSL_KEY_PASSWORD=replace_with_key_password
KAFKA_SSL_TRUSTSTORE_LOCATION=file:/path/to/client.truststore.jks
KAFKA_SSL_TRUSTSTORE_PASSWORD=replace_with_truststore_password

# MySQL
MYSQL_HOST_PORT=3306
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=event_streaming
MYSQL_USERNAME=event_app
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
# Optional locally because the Processing Service derives this from host, port, and database.
MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/event_streaming?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Cloud profile only: keep false unless runtime API documentation should be public.
API_DOCUMENTATION_ENABLED=false

# Retry behavior; final defaults will be chosen during Phase 7.
EVENT_RETRY_MAX_ATTEMPTS=3
EVENT_RETRY_BACKOFF_MS=1000

# Spring profile
SPRING_PROFILES_ACTIVE=local

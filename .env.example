# Copy this file to .env for local development when Docker Compose is added.
# The values below are non-secret development placeholders. Never commit .env.

# Service ports
INGESTION_SERVER_PORT=8080
PROCESSING_SERVER_PORT=8081

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_ORDER_EVENTS_TOPIC=order.events.v1
KAFKA_ORDER_EVENTS_DLT_TOPIC=order.events.v1.dlt
KAFKA_PROCESSING_CONSUMER_GROUP=order-processing-v1

# Optional Kafka TLS locations for a cloud profile.
# Do not place real certificates or private keys in the repository.
KAFKA_SSL_CA_LOCATION=
KAFKA_SSL_CERTIFICATE_LOCATION=
KAFKA_SSL_KEY_LOCATION=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=event_streaming
MYSQL_USERNAME=event_app
MYSQL_PASSWORD=replace_with_local_password

# Browser access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Retry behavior; final defaults will be chosen during Phase 7.
EVENT_RETRY_MAX_ATTEMPTS=3
EVENT_RETRY_BACKOFF_MS=1000

# Spring profile
SPRING_PROFILES_ACTIVE=local
